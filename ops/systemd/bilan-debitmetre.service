# Synthetic host alias: host-a. Install only on the host that owns this dataset.
[Unit]
Description=bilan debitmetre Codex usage shipper (host-a)
Documentation=file:/opt/bilan/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bilan
Group=bilan
WorkingDirectory=/var/lib/bilan/host-a
ExecStart=/usr/bin/python3 /opt/bilan/shippers/debitmetre.py \
  --usage-file /var/lib/bilan/host-a/debitmetre/usage.jsonl \
  --state-file /var/lib/bilan/host-a/state/debitmetre.json \
  --producer-id debitmetre-main \
  --endpoint https://bilan-ingest.example.com/api/v1/ingest \
  --token-file /etc/bilan/debitmetre.token \
  --timeout 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bilan/host-a/state
