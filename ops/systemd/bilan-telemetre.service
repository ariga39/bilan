# Synthetic host alias: host-c. Install only on the host that owns this dataset.
[Unit]
Description=bilan telemetre AGY and Codex quota shipper (host-c)
Documentation=file:/opt/bilan/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bilan
Group=bilan
WorkingDirectory=/var/lib/bilan/host-c
ExecStart=/usr/bin/python3 /opt/bilan/shippers/telemetre.py \
  --database /var/lib/bilan/host-c/telemetre/quota.sqlite3 \
  --state-file /var/lib/bilan/host-c/state/telemetre.json \
  --producer-id telemetre-quota \
  --endpoint https://bilan-ingest.example.com/api/v1/ingest \
  --token-file /etc/bilan/telemetre.token \
  --timeout 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bilan/host-c/state
