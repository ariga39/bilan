{
  "name": "bilan",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter bilan-web build",
    "build-storybook": "pnpm --filter bilan-web build-storybook",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:acceptance && pnpm test",
    "dev:ingest": "pnpm --filter bilan-ingest exec wrangler dev --port 8787 --test-scheduled --persist-to ../../.wrangler/state",
    "dev:web": "pnpm --filter bilan-web dev",
    "db:migrate:local": "pnpm --filter bilan-ingest exec wrangler d1 migrations apply bilan --local --persist-to ../../.wrangler/state",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "storybook": "pnpm --filter bilan-web storybook",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter bilan-web test:e2e",
    "test:e2e:b5": "pnpm --filter bilan-web test:e2e:b5",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:acceptance": "tsc -p acceptance/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.20.0"
}
