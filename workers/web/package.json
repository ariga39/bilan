{
  "name": "bilan-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "pnpm test:worker && pnpm test:ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:b5": "vitest run --config vitest.e2e.config.ts test/e2e/b5.test.tsx",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@bilan/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.22",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "4.1.12",
    "wrangler": "^4.168.0"
  }
}
