{
  "name": "bilan-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build --output-dir storybook-static",
    "dev": "vite dev",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006",
    "test": "pnpm test:worker && pnpm test:ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:b5": "vitest run --config vitest.e2e.config.ts test/e2e/b5.test.tsx",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@bilan/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.22",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@sinonjs/fake-timers": "15.5.0",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^31.0.1",
    "storybook": "10.6.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "4.1.12",
    "wrangler": "^4.168.0"
  }
}
