{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/client/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    "src/query/**/*.ts",
    "src/router.tsx",
    "src/server.ts",
    "src/search.ts",
    "src/routeTree.gen.ts",
    "src/server-env.d.ts",
    "vite.config.ts",
    "vitest.ui.config.ts",
    "vitest.e2e.config.ts",
    "test/ui/**/*.ts",
    "test/ui/**/*.tsx",
    "test/e2e/**/*.ts",
    "test/e2e/**/*.tsx"
  ]
}
